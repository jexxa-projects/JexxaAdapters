<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.jexxa.adapters</groupId>
        <artifactId>parent</artifactId>
        <version>5.0.0-RC2-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jexxa-adapters-bom</artifactId>
    <packaging>pom</packaging>

    <name>Jexxa Adapters BOM</name>
    <description>
        Centralized dependency management for Jexxa adapters.
    </description>
    <build>
        <plugins>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>io.jexxa.adapters</groupId>
                <artifactId>adapter-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.jexxa.adapters</groupId>
                <artifactId>adapter-s3</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.jexxa.adapters</groupId>
                <artifactId>adapter-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.jexxa.adapters</groupId>
                <artifactId>adapter-jms</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.jexxa.adapters</groupId>
                <artifactId>adapter-rest</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.jexxa.adapters</groupId>
                <artifactId>adapter-esp</artifactId>
                <version>${project.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

</project>
